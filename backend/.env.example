PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/betterreads?replicaSet=rs0
JWT_SECRET=replace_with_a_cryptographically_random_secret
# Access-token lifetime (short; an httpOnly refresh session silently renews it).
ACCESS_TOKEN_TTL=15m
# Refresh session / cookie lifetime, in days.
REFRESH_TOKEN_TTL_DAYS=30
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional frontend origins; no paths or trailing slashes.
FRONTEND_ORIGINS=
# Base URL used in verification/reset email links. Defaults to FRONTEND_URL.
APP_URL=http://localhost:5173
# Optional cookie domain to share auth cookies across subdomains (e.g. .dvyanshu.page).
# Leave blank to scope cookies to the exact API host.
COOKIE_DOMAIN=
# Outbound email (SMTP via Nodemailer). Leave MAIL_ENABLED=false in local dev to
# log verification & reset links to the server console instead of sending mail.
# Set it to true (and fill SMTP_USER/SMTP_PASS) to send real email.
# Defaults below are for Brevo (https://www.brevo.com) — SMTP & API > SMTP.
MAIL_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Brevo login (an email address it shows you), and an SMTP key it generates
# (NOT your account password).
SMTP_USER=
SMTP_PASS=
# Must be an address on a domain you control and have verified in Brevo.
SMTP_FROM=BetterReads <no-reply@dvyanshu.page>
# Google Sign-In: OAuth client ID from https://console.cloud.google.com (leave blank to disable).
# The same value must be set as VITE_GOOGLE_CLIENT_ID for the frontend.
# NOTE: OAuth is dark in production until GOOGLE_CLIENT_ID is set here, VITE_GOOGLE_CLIENT_ID
# is set in the frontend build, and the prod origin is listed under the OAuth client's
# "Authorized JavaScript origins" in the Google Cloud Console.
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NODE_ENV=development

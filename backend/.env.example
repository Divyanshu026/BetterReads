PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/betterreads?replicaSet=rs0
JWT_SECRET=replace_with_a_cryptographically_random_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
# Google Sign-In: OAuth client ID from https://console.cloud.google.com (leave blank to disable).
# The same value must be set as VITE_GOOGLE_CLIENT_ID for the frontend.
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NODE_ENV=development
